# ============================================
# Environment Variables
# ============================================
# Copy to `.env.local` for Next.js, or `.env` for docker compose.
# Only variables read by this codebase are listed - add yours here and in
# README.md / AGENTS.md.

# ============================================
# Analytics (optional)
# ============================================

# Cloudflare Web Analytics token. Omit to disable the beacon.
# CF_WEB_ANALYTICS_TOKEN=

# `VERCEL` is set automatically by Vercel - do not set it locally.
# It gates @vercel/analytics + @vercel/speed-insights and disables the
# standalone output used by the Docker image.

# ============================================
# Docker Compose
# ============================================

# Compose project name (shown in `docker compose ls`, reused for the image)
DOCKER_PROJECT_NAME=fractal-template
# Host port mapped to the container's internal port 3000
DOCKER_PORT=3000
