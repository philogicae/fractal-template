{
  "name": "fractal-template",
  "description": "A modern Next.js template with HeroUI, Tailwind CSS, and TypeScript",
  "version": "1.10.0",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "minimumReleaseAge": 4320,
  "repository": {
    "type": "git",
    "url": "https://github.com/philogicae/fractal-template.git"
  },
  "homepage": "https://github.com/philogicae/fractal-template",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000 --turbo",
    "lint": "biome check --write app --unsafe",
    "build": "next build --turbo",
    "start": "next start -H 0.0.0.0 -p 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "upgrade": "pnpm update && pnpm prune",
    "clean": "rimraf .next && rimraf out && rimraf node_modules && pnpm install",
    "repomix": "pnpx repomix --style markdown --remove-empty-lines"
  },
  "dependencies": {
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "csso": "^5.0.5",
    "marked": "^18.0.10",
    "next": "^16.3.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "terser": "^5.50.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/csso": "^5.0.5",
    "@types/node": "26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "clsx": "^2.1.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
