{
  "name": "fractal-template",
  "description": "A modern Next.js template with HeroUI, Tailwind CSS, and TypeScript",
  "version": "1.18.0",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "minimumReleaseAge": 4320,
  "repository": {
    "type": "git",
    "url": "https://github.com/philogicae/fractal-template.git"
  },
  "homepage": "https://github.com/philogicae/fractal-template",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000 --turbo",
    "lint": "biome check --write app --unsafe",
    "build": "next build --turbo",
    "start": "next start -H 0.0.0.0 -p 3000",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "upgrade": "pnpm update && pnpm prune",
    "clean": "rimraf .next && rimraf out && rimraf node_modules && pnpm install",
    "repomix": "pnpx repomix --style markdown --remove-empty-lines"
  },
  "dependencies": {
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "^3.2.7",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "csso": "^5.0.5",
    "marked": "^18.1.3",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "terser": "^5.51.2",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/csso": "^5.0.5",
    "@types/node": "26.1.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "clsx": "^2.1.1",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
